{
  "name": "symmetrical-productivity-root",
  "compatibility_date": "2026-04-01",
  "main": "worker.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
